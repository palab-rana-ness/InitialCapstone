# Copy this file to .env and fill in values. Never commit the real .env file.

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default
S3_BUCKET=retail-data-lake-dev-<your-account-id>

# FastAPI source system (existing mock server, do not modify)
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Pipeline identity
PIPELINE_ID=retail_data_pipeline
ENVIRONMENT=dev
SERVICE_VERSION=1.0.0

# New Relic / OTLP (never commit real license key)
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_USER_API_KEY=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_REGION=us
NEW_RELIC_SERVICE_NAME=retail-spark-pipeline
# Optional: override OTLP endpoint when direct access to New Relic OTLP is blocked
# Example: https://<your-otel-gateway>:4318
NEW_RELIC_OTLP_ENDPOINT=

# Alert thresholds
SILVER_INVALID_RATE_THRESHOLD=0.10

# Pagination page size used when calling the FastAPI source APIs
API_PAGE_SIZE=200

# HTTP request timeout (seconds) for FastAPI calls
API_TIMEOUT_SECONDS=30

# Spark tuning
SPARK_SHUFFLE_PARTITIONS=8
SPARK_APP_NAME=retail_data_pipeline
