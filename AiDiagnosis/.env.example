# Groq LLM configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1

# Chroma configuration
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=incident_memory

# Retrieval configuration
SIMILAR_INCIDENTS_TOP_K=5

# New Relic configuration (log retrieval agent)
NEWRELIC_API_KEY=
NEWRELIC_ACCOUNT_ID=
NEWRELIC_GRAPHQL_ENDPOINT=https://api.newrelic.com/graphql
NEWRELIC_LOG_LOOKBACK_MINUTES=60
NEWRELIC_LOG_LIMIT=200

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
